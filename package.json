{
	"name": "encoder",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"build": "tsc && vite build",
		"dev": "vite",
		"format": "prettier --write .",
		"lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" && prettier --check .",
		"lint:fix": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" --fix",
		"prepare": "husky",
		"preview": "vite preview"
	},
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@fortawesome/react-fontawesome": "^3.5.0",
		"@heroui/react": "^3.2.6",
		"@heroui/styles": "^3.2.6",
		"html-entities": "^2.6.0",
		"i18next": "^26.4.2",
		"md5": "^2.3.0",
		"qrcode": "^1.5.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-ga4": "^3.0.1",
		"xmorse": "^1.0.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@shangzhen/eslint-config": "^6.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/md5": "^2.3.6",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^9.39.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"organize-imports-cli": "^1.0.2",
		"prettier": "^3.9.9",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vite-plugin-pwa": "^1.3.0"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"organize-imports-cli",
			"prettier --write"
		]
	}
}
